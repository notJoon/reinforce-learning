{
  "name": "qlearn-lite",
  "version": "0.1.0",
  "description": "Lightweight, reusable tabular Q-learning for discrete RL environments",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "test": "cd .. && jest --selectProjects qlearn-lite",
    "test:watch": "cd .. && jest --selectProjects qlearn-lite --watch",
    "test:coverage": "cd .. && jest --selectProjects qlearn-lite --coverage",
    "test:verbose": "cd .. && jest --selectProjects qlearn-lite --verbose",
    "format": "cd .. && prettier --write \"qlearn-lite/**/*.{ts,js,json}\" --ignore-path .gitignore",
    "format:check": "cd .. && prettier --check \"qlearn-lite/**/*.{ts,js,json}\" --ignore-path .gitignore",
    "example:knight": "cd ../demo && npm run dev:knight"
  },
  "keywords": [
    "reinforcement-learning",
    "q-learning",
    "rl",
    "tabular",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "ts-node": "^10.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
